# Default: serve the committed dataset. No external services or keys required.
DATA_SOURCE_MODE="file"
# Optional: database mode requires a provisioned PostgreSQL database and imported data.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
# Optional: only required to fetch Census data, never needed by the dashboard UI.
# CENSUS_API_KEY="your-census-api-key"
